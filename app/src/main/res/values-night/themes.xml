<resources>
    <!--
        The night sheet, dressed on the window for the frames before the first
        composition. It carries a dark parent so the platform reads the app as a
        dark-themed one and leaves the paper alone rather than force-inverting the
        cream. PaperPalette.night owns every colour past this point.
    -->
    <style name="Theme.ToDoList" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.ToDoList.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_sticky_settle</item>
        <item name="windowSplashScreenAnimationDuration">@integer/splash_settle_millis</item>
        <item name="postSplashScreenTheme">@style/Theme.ToDoList</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
