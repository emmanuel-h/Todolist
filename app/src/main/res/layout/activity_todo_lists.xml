<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/inlineAddListRow"
            layout="@layout/item_todo_list_inline_add"
            android:visibility="gone" />

        <View
            android:id="@+id/inlineAddListDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/paper_rule_height"
            android:layout_marginStart="@dimen/paper_gutter_width"
            android:background="@color/paper_rule"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewLists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/list_horizontal_inset"
            android:paddingEnd="@dimen/list_horizontal_inset"
            android:paddingTop="64dp"
            android:paddingBottom="88dp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReplayTutorial"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:alpha="0.45"
        android:contentDescription="@string/replay_tutorial"
        app:icon="@drawable/ic_replay"
        app:iconTint="?attr/colorOutline" />

    <FrameLayout
        android:id="@+id/stickyNotePad"
        android:layout_width="@dimen/sticky_note_pad_size"
        android:layout_height="@dimen/sticky_note_pad_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/stickyNoteBack"
            android:layout_width="@dimen/sticky_note_sheet_size"
            android:layout_height="@dimen/sticky_note_sheet_size"
            android:layout_gravity="center"
            android:background="@drawable/sticky_note_sheet_back"
            android:elevation="1dp"
            android:rotation="4" />

        <View
            android:id="@+id/stickyNoteMid"
            android:layout_width="@dimen/sticky_note_sheet_size"
            android:layout_height="@dimen/sticky_note_sheet_size"
            android:layout_gravity="center"
            android:background="@drawable/sticky_note_sheet_mid"
            android:elevation="2dp"
            android:rotation="2" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddList"
            android:layout_width="@dimen/sticky_note_sheet_size"
            android:layout_height="@dimen/sticky_note_sheet_size"
            android:layout_gravity="center"
            android:contentDescription="@string/add_list_fab_description"
            android:foreground="@drawable/sticky_note_edge"
            android:rotation="-1"
            app:backgroundTint="@color/sticky_note"
            app:elevation="4dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Paper.Sticky"
            app:srcCompat="@drawable/ic_add"
            app:tint="@color/ink" />

        <ImageView
            android:id="@+id/stickyNotePeel"
            android:layout_width="@dimen/sticky_note_sheet_size"
            android:layout_height="@dimen/sticky_note_sheet_size"
            android:layout_gravity="center"
            android:background="@drawable/sticky_note_sheet_top"
            android:contentDescription="@string/add_list_fab_description"
            android:elevation="6dp"
            android:importantForAccessibility="no"
            android:rotation="-1"
            android:scaleType="center"
            android:src="@drawable/ic_add"
            android:tint="@color/ink"
            android:visibility="gone" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
