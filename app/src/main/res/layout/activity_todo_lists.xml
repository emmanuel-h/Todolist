<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/inlineAddListRow"
            layout="@layout/item_todo_list_inline_add"
            android:visibility="gone" />

        <View
            android:id="@+id/inlineAddListDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/paper_rule_height"
            android:layout_marginStart="@dimen/paper_gutter_width"
            android:background="@color/paper_rule"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewLists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/list_horizontal_inset"
            android:paddingEnd="@dimen/list_horizontal_inset"
            android:paddingTop="64dp"
            android:paddingBottom="88dp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReplayTutorial"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:alpha="0.45"
        android:contentDescription="@string/replay_tutorial"
        app:icon="@drawable/ic_replay"
        app:iconTint="?attr/colorOutline" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/add_list_fab_description"
        android:foreground="@drawable/fab_paper_outline"
        app:backgroundTint="@color/paper_sheet"
        app:elevation="3dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Paper.Chip"
        app:srcCompat="@drawable/ic_add"
        app:tint="?attr/colorPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
