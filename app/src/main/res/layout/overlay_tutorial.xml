<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tutorialOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="no"
    android:visibility="gone">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tutorialBannerCard"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:importantForAccessibility="no"
        android:visibility="invisible"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tutorialBannerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:padding="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/tutorialHand"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:importantForAccessibility="no" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tutorialCaptionPill"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:importantForAccessibility="no"
        android:visibility="invisible"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tutorialCaptionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tutorialProgressPill"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:importantForAccessibility="no"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <View
                android:id="@+id/tutorialDot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_tutorial"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/tutorialDot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/dot_tutorial"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/tutorialDot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/dot_tutorial"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/tutorialDot4"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/dot_tutorial"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/tutorialDot5"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/dot_tutorial"
                android:importantForAccessibility="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTutorialSkip"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/cancel"
                app:icon="@drawable/ic_close"
                app:iconTint="?attr/colorOnSurface" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
