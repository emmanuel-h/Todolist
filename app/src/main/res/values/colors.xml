<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The ink-on-paper palette lives in PaperInk, not here — one source of truth,
        and the only consumers of a colour resource left are the window it is painted
        on before Compose draws, the splash it hands over to, and the sheet the
        launcher icon is a corner of. See docs/paper-design-system.md.
    -->
    <color name="paper">#FAF5EA</color>

    <!--
        The launcher's sheet, and the one paper that never turns the lamp down.
        A launcher rasterises an adaptive icon once and keeps it, so an icon painted
        from a colour with a values-night twin keeps whichever mode it was cached in
        and shows up dark on a light home screen. This must never gain a night
        counterpart, which is why it is not @color/paper. See docs/app-icons.md.
    -->
    <color name="launcher_paper">#FAF5EA</color>
</resources>
