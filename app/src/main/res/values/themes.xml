<resources>
    <!--
        The app is entirely Compose: PaperTheme owns every colour and PaperSurface
        draws the paper itself. All this theme still has to do is dress the window
        for the frames before the first composition and keep the system bars out of
        the way. See docs/compose-teardown.md.
    -->
    <style name="Theme.ToDoList" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
