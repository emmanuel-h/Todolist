<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Width of the leading spacer in the inline-add row, matching the
         MaterialCheckBox touch target (wrap_content ~32dp) plus its end
         margin (12dp) so the text field aligns with todo item titles. -->
    <dimen name="inline_add_leading_spacer">44dp</dimen>
    <!-- Collapsed ghost-row height — slimmer than the full 56dp item row. -->
    <dimen name="inline_add_ghost_height">40dp</dimen>
    <!-- Horizontal inset that caps list content width on large screens so rows
         stay readable instead of stretching edge to edge. Zero on handsets. -->
    <dimen name="list_horizontal_inset">0dp</dimen>
    <!-- Paper gutter: row content starts here and the ruling begins here. The
         hole punches live to its left. -->
    <dimen name="paper_gutter_width">40dp</dimen>
    <dimen name="paper_rule_height">1dp</dimen>
    <!-- Section-header row clears the gutter plus the ruling's own inset. -->
    <dimen name="paper_section_inset">48dp</dimen>
    <!-- Toolbar padding so the navigation icon never crosses the hole column. -->
    <dimen name="paper_toolbar_inset">32dp</dimen>
    <!-- Sticky-note pad. The pad box is oversized so the rotated sheets below the
         top one are not clipped; each sheet stays square at the sheet size. -->
    <dimen name="sticky_note_pad_size">72dp</dimen>
    <dimen name="sticky_note_sheet_size">56dp</dimen>
    <dimen name="sticky_note_corner">2dp</dimen>
    <!-- Distance the peeled sheet travels toward the list before it fades out. -->
    <dimen name="sticky_note_peel_travel_x">12dp</dimen>
    <dimen name="sticky_note_peel_travel_y">28dp</dimen>
</resources>
