<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
        </shape>
    </item>

    <item>
        <bitmap
            android:src="@drawable/tile_paper_grain"
            android:tileMode="repeat"
            android:tint="@color/paper_grain_tint" />
    </item>

    <item
        android:width="@dimen/paper_gutter_width"
        android:gravity="start|fill_vertical">
        <bitmap
            android:src="@drawable/tile_paper_hole"
            android:tileMode="repeat"
            android:tint="@color/paper_hole_tint" />
    </item>

    <item
        android:width="@dimen/paper_margin_primary_width"
        android:gravity="start|fill_vertical"
        android:start="@dimen/paper_margin_primary_inset">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper_margin_rule" />
        </shape>
    </item>

    <item
        android:width="@dimen/paper_margin_secondary_width"
        android:gravity="start|fill_vertical"
        android:start="@dimen/paper_margin_secondary_inset">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper_margin_rule_soft" />
        </shape>
    </item>

</layer-list>
