    <target android:name="settle">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1.06"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="@integer/splash_settle_millis"
                    android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1.06"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:duration="@integer/splash_settle_millis"
                    android:interpolator="@android:interpolator/decelerate_quint" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="castAmbient">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="0.07"
                android:valueType="floatType"
                android:duration="@integer/splash_settle_millis"
