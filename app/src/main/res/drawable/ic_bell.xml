<?xml version="1.0" encoding="utf-8"?>
<!--
    A bell drawn the way the rest of the family is drawn: one stroked path,
    no fill, round caps. Three subpaths in one path element: the dome (two
    symmetric bezier curves sharing their top at the crown), the rim (wider
    than the dome), and the clapper (a short stroke below the rim).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M12,4 C7,4 5,9 5,17 M12,4 C17,4 19,9 19,17 M3,17 H21 M12,20 V22"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
