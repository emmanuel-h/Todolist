<?xml version="1.0" encoding="utf-8"?>
<!--
    The tile is a piece of the page, and this is what is written on it: three
    ruled lines, the first two ticked off and the last still waiting.

    There is no sheet drawn around the writing any more. A sheet drawn inside the
    tile has to provide its own silhouette, and the launcher then cuts a circle
    around it — which is the square inside a circle the report is about (#73).
    With the writing alone on the background's paper, the mask *is* the
    silhouette, and the tile reads the same under circle, squircle and rounded
    square. It also puts this layer and the monochrome one on the same drawing,
    which they were never on before.

    Every mark stays inside the 66-unit safe circle; LaunchMarkTest measures it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#00000000"
        android:pathData="M50,42 L76,42"
        android:strokeColor="#6F6A5E"
        android:strokeWidth="4"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M50,54 L76,54"
        android:strokeColor="#6F6A5E"
        android:strokeWidth="4"
