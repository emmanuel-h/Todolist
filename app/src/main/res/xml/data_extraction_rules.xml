<?xml version="1.0" encoding="utf-8"?>
<!--
   The API 31+ form of backup_rules.xml, split by destination.

   The lists and their items travel either way; naming them with <include> is
   what keeps shared_prefs/ behind. A permission the old device already spent
   must not travel, or the new one is silently reminder-less with no in-app route
   to fix it, and neither must the demo bookkeeping, so a restored install still
   gets its tour.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="todo_database" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="todo_database" />
    </device-transfer>
</data-extraction-rules>
