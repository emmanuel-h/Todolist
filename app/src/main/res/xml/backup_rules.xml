<?xml version="1.0" encoding="utf-8"?>
<!--
   What survives a device-to-device restore.

   Naming the database is also what keeps everything else off the wire: an
   <include> makes the backup a whitelist, so shared_prefs/ stays behind. That is
   deliberate. A permission the old device already spent must not travel, or the
   new one is silently reminder-less with no in-app route to fix it, and the demo
   bookkeeping must not either, so a restored install still gets its tour.
-->
<full-backup-content>
    <include domain="database" path="todo_database" />
</full-backup-content>
